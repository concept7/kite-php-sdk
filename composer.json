{
    "name": "concept7/kite-php-sdk",
    "description": "Framework-agnostic Kite PHP SDK for project monitoring",
    "keywords": [
        "Concept7",
        "kite",
        "monitoring"
    ],
    "homepage": "https://github.com/concept7/kite-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Martijn Wagena",
            "email": "martijn@concept7.nl",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/concept7/kite-php-sdk/issues",
        "source": "https://github.com/concept7/kite-php-sdk"
    },
    "require": {
        "php": "^8.2",
        "composer/composer": "^2.9",
        "illuminate/pipeline": "^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "saloonphp/saloon": "^4.0",
        "symfony/process": "^5.4||^6.4||^7.0||^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "pestphp/pest": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "Concept7\\Kite\\": "src/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
