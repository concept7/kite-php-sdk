{
    "name": "concept7/kite-php-sdk",
    "description": "Framework-agnostic Kite PHP SDK for project monitoring",
    "keywords": [
        "Concept7",
        "kite",
        "monitoring"
    ],
    "homepage": "https://gitlab.concept7.nl/workflow/kite-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Martijn Wagena",
            "email": "martijn@concept7.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer/composer": "^2.9",
        "illuminate/pipeline": "^8.0||^9.0||^10.0||^11.0||^12.0",
        "illuminate/support": "^8.0||^9.0||^10.0||^11.0||^12.0",
        "saloonphp/saloon": "^3.0",
        "symfony/process": "^5.4||^6.4||^7.0||^8.0"
    },
    "autoload": {
        "psr-4": {
            "Concept7\\Kite\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.27"
    }
}